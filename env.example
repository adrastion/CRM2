# Database (PostgreSQL)
# Замените username, password на ваши данные PostgreSQL
# По умолчанию используется: postgres / 0408
DATABASE_URL="postgresql://postgres:0408@localhost:5432/martial_arts_crm?schema=public"

# JWT
# На проде: длинный случайный JWT_SECRET (≥32). Для школьного staff рекомендуем JWT_EXPIRES_IN=1d (по умолчанию 7d).
JWT_SECRET="58392047168309527418963054271936"
JWT_EXPIRES_IN="7d"
# JWT_EXPIRES_IN_REMEMBER="30d"  # единый вход с «запомнить меня»

# Auth cookies (httpOnly) + CSRF. Bearer из localStorage остаётся для multi-account.
AUTH_COOKIE_ENABLED=true
# COOKIE_SECURE=true          # принудительно Secure (на проде и так при NODE_ENV=production)
# COOKIE_SAMESITE=lax         # lax | strict | none (none только с Secure)

# Server
PORT=3001
NODE_ENV="development"

# Email (for password recovery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@martialartscrm.com"

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# Rate Limiting (общий API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Rate Limiting на вход (логин / identify / setup-password)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

# CORS
CORS_ORIGIN="http://localhost:3000"

# Push Notifications (VAPID keys)
# Сгенерируйте ключи с помощью команды: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"  # или ваш email

# YooKassa Payment Gateway
# Для тестового режима используйте тестовые ключи из личного кабинета YooKassa
# Для реального режима используйте реальные ключи из раздела "Настройки" → "API"
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"
YOOKASSA_TEST_MODE="false"  # true для тестового режима, false для реального
