}

/// Событие календаря школы: родительские собрания и прочие мероприятия (без посещаемости/биллинга).
model SchoolEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// parent_meeting | other
  type        String    @default("other")
  startTime   DateTime
  endTime     DateTime
  location    String?
  tenantId    String
  branchId    String?
  groupId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([tenantId, startTime])
  @@index([tenantId, type])
  @@map("school_events")
}

model CompetitionParticipant {
  id            String                 @id @default(cuid())
  competitionId String
  clientId      String
  tenantId      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  attendance    CompetitionAttendance?
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results       CompetitionResult[]

  @@unique([competitionId, clientId])
  @@map("competition_participants")
}

model CompetitionResult {
  id              String                 @id @default(cuid())
  competitionId   String
  participantId   String
  result          String?
  resultValue     Decimal?
  category        String?
  performanceTime DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  competition     Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant     CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("competition_results")
}

model CompetitionTrainer {
  id            String      @id @default(cuid())
  competitionId String
  trainerId     String
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer       Trainer     @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([competitionId, trainerId])
  @@map("competition_trainers")
}

model CompetitionAttendance {
  id            String                 @id @default(cuid())
  competitionId String
  participantId String                 @unique
  status        String
  notes         String?
  tenantId      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant   CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("competition_attendances")
}

// --- Платформа: техподдержка, дизайнеры, служба безопасности, записи звонков ---

model PlatformStaffUser {
  id               String                 @id @default(cuid())
  email            String                 @unique
  password         String
  firstName        String
  lastName         String
  role             String // SUPPORT | DESIGNER | SECURITY
  isActive         Boolean                @default(true)
  mustChangePassword Boolean              @default(true)
  passwordChangedAt DateTime?
  lastLogin        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  assignedTickets  SupportTicket[]        @relation("TicketAssignedStaff")
  messages         SupportTicketMessage[]
  callRecordings   DesignerCallRecording[]

  @@map("platform_staff_users")
}

model SupportTicket {
  id              String                  @id @default(cuid())
  tenantId        String
  channel         String // SUPPORT | DESIGNER (клиенты) | DESIGNER_SUPERADMIN (дизайнер ↔ супер-админы)
  status          String                  @default("OPEN") // OPEN | WAITING | ASSIGNED | CLOSED
  clientId        String?
  parentId        String?
  assignedStaffId String?
  subject         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  closedAt        DateTime?
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client?                 @relation("ClientSupportTickets", fields: [clientId], references: [id], onDelete: Cascade)
  parent          Parent?                 @relation("ParentSupportTickets", fields: [parentId], references: [id], onDelete: Cascade)
  assignedStaff   PlatformStaffUser?      @relation("TicketAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages        SupportTicketMessage[]
  callRecordings  DesignerCallRecording[]

  @@index([tenantId, channel, status])
  @@index([channel, status])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id                   String             @id @default(cuid())
  ticketId             String
  authorType           String // client | parent | platform_staff | super_admin
  body                 String
  authorClientId       String?
  authorParentId       String?
  authorStaffId        String?
  authorSuperAdminId   String?
  createdAt            DateTime           @default(now())
  ticket               SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorStaff          PlatformStaffUser? @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)
  authorSuperAdmin     SuperAdmin?        @relation(fields: [authorSuperAdminId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model SupportKnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_knowledge_articles")
}

/// Записи видеозвонков дизайнер–клиент; хранятся 14 суток (expiresAt), затем удаляются кроном
model DesignerCallRecording {
  id                       String             @id @default(cuid())
  ticketId                 String
  storagePath              String
  mimeType                 String
  durationSec              Int?
  startedAt                DateTime
  endedAt                  DateTime?
  expiresAt                DateTime
  recordedByStaffId        String?
  uploadedByRequesterKind  String? // TENANT_USER | MARKETER | PROMO_CODE_ADMIN
  uploadedByRequesterId    String?
  ticket                   SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  recordedBy               PlatformStaffUser? @relation(fields: [recordedByStaffId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([ticketId])
  @@map("designer_call_recordings")
}

/// Внутришкольные и платформенные чаты

enum ChatThreadType {
  CLIENT_ADMIN
  CLIENT_TRAINER
  GROUP
  TRAINER_ADMIN
  TRAINERS
  PLATFORM_TESTERS
  SUPER_ADMINS
}

model ChatThread {
  id            String         @id @default(cuid())
  /// null для платформенных бесед (PLATFORM_TESTERS / SUPER_ADMINS)
  tenantId      String?
  type          ChatThreadType
  /// Глобально уникальный ключ (для TRAINERS — trainers:{tenantId})
  threadKey     String         @unique
  clientId      String?
  trainerId     String?
  groupId       String?
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer       Trainer?       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  reads         ChatThreadRead[]

  @@index([tenantId, type])
  @@index([tenantId, lastMessageAt])
  @@index([type])
  @@map("chat_threads")
}

model ChatMessage {
  id               String     @id @default(cuid())
  threadId         String
  tenantId         String?
  body             String     @db.Text
  /// CLIENT | PARENT | USER | SUPER_ADMIN | TESTER
  authorType       String
  authorClientId   String?
  authorParentId   String?
  authorUserId     String?
  authorSuperAdminId String?
  authorTesterId   String?
  createdAt        DateTime   @default(now())
  editedAt         DateTime?
  thread           ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([tenantId, createdAt])
  @@map("chat_messages")
}

model ChatThreadRead {
  id         String     @id @default(cuid())
  threadId   String
  /// CLIENT | PARENT | USER | SUPER_ADMIN | TESTER
  readerType String
  readerId   String
  lastReadAt DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, readerType, readerId])
  @@index([readerType, readerId])
  @@map("chat_thread_reads")
}
