generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                   @id @default(cuid())
  name                    String
  subdomain               String                   @unique
  email                   String                   @unique
  phone                   String?
  address                 String?
  logo                    String?
  settings                String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  attendances             Attendance[]
  branches                Branch[]
  clientMemberships       ClientMembership[]
  clients                 Client[]
  competitionAttendances  CompetitionAttendance[]
  competitionParticipants CompetitionParticipant[]
  competitionTrainers     CompetitionTrainer[]
  competitions            Competition[]
  groups                  Group[]
  halls                   Hall[]
  marketers               Marketer[]
  memberships             Membership[]
  parents                 Parent[]
  payments                Payment[]
  promoCodeAdmins         PromoCodeAdmin[]
  promoCodeUsages         PromoCodeUsage[]
  promoCodes              PromoCode[]
  referralClicks          ReferralClick[]
  referralLinks           ReferralLink[]
  schoolEvents            SchoolEvent[]
  standards               Standard[]
  subscription            Subscription?
  referredBy              TenantMarketer?
  tenantSettings          TenantSettings?
  trainers                Trainer[]
  trainings               Training[]
  transactions            Transaction[]
  financeOperations       FinanceOperation[]
  financeOperationTypes   FinanceOperationType[]
  users                   User[]
  supportTickets          SupportTicket[]
  trainerSalaryLedgers    TrainerSalaryLedger[]
  chatThreads             ChatThread[]
  clientContracts         ClientContract[]

  @@map("tenants")
}

model TenantSettings {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  defaultTrainingDuration  Int      @default(60)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  hasCompletedOnboarding   Boolean  @default(false)
  onboardingDeclined       Boolean  @default(false)
  membershipFeeResetDate   String?
  // День месяца выплаты зарплаты сотрудникам (1–28)
  salaryPayoutDay          Int      @default(25)
  /// Сколько минут после отправки можно редактировать сообщение в чатах школы (0 = без ограничения)
  chatMessageEditLimitMinutes Int    @default(15)
  // Настройки личного кабинета клиента
  clientCanViewAllTrainers Boolean  @default(false) // Может ли клиент видеть всех тренеров или только своего
  clientCanViewAllBranches Boolean  @default(false) // Может ли клиент видеть все филиалы или только свой
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id            String    @id @default(cuid())
  email         String
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          String
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLogin     DateTime?
  /// Инкремент при смене пароля / деактивации — инвалидирует выданные JWT.
  sessionVersion Int      @default(0)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  middleName    String?
  trainer       Trainer?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedSuperAdmin SuperAdmin?
  linkedTester     Tester?
  uploadedContracts ClientContract[]
  uploadedAddenda   ClientContractAddendum[]

  @@unique([tenantId, email])
  @@map("users")
}

model Branch {
  id          String          @id @default(cuid())
  name        String
  address     String
  phone       String?
  email       String?
  description String?
  isActive    Boolean         @default(true)
  tenantId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups      Group[]
  halls       Hall[]
  payments    Payment[]
  schoolEvents SchoolEvent[]
  trainers    TrainerBranch[]
  trainings   Training[]
  financeOperations FinanceOperation[]

  @@index([tenantId, isActive])
  @@map("branches")
}

model Hall {
  id          String     @id @default(cuid())
  name        String
  description String?
  capacity    Int?
  isActive    Boolean    @default(true)
  branchId    String
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainings   Training[]

  @@map("halls")
}

model Client {
  id                       String                   @id @default(cuid())
  firstName                String
  lastName                 String
  middleName               String?
  email                    String?
  phone                    String?
  dateOfBirth              DateTime?
  gender                   String?
  address                  String?
  emergencyContact         String?
  emergencyPhone           String?
  medicalNotes             String?
  photo                    String?
  isActive                 Boolean                  @default(true)
  tenantId                 String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  birthCertificateNumber   String?
  medicalCertificateNumber String?
  schoolOrKindergarten     String?
  balance                  Decimal                  @default(0)
  /// Относительный путь в uploads/ (раньше мог быть data URL / base64)
  birthCertificate         String?
  /// Относительный путь в uploads/ (раньше мог быть data URL / base64)
  medicalCertificate       String?
  weight                   Decimal?
  /// Спортивная дисциплина (вид спорта)
  discipline               String?
  /// Весовая категория профиля
  weightCategory           String?
  /// Статус спортсмена: active | pause | injury | left
  athleteStatus            String                   @default("active")
  membershipFeePaid        Boolean                  @default(false)
  membershipFeePaidAt      DateTime?
  membershipFeePaidBy      String?
  /// Личная скидка на ежемесячный платёж: percent | fixed
  personalDiscountType     String?
  personalDiscountValue    Decimal?
  passportBirthPlace       String?
  passportDivisionCode     String?
  passportIssueDate        DateTime?
  passportIssuedBy         String?
  passportNumber           String?
  passportSeries           String?
  // Поля для личного кабинета клиента
  password                 String? // Пароль для авторизации
  emailVerified            Boolean                  @default(false)
  isAccountApproved        Boolean                  @default(false) // Подтвержден ли аккаунт администратором
  accountApprovedAt        DateTime? // Дата подтверждения
  accountApprovedBy        String? // Кто подтвердил (userId)
  lastLogin                DateTime? // Последний вход
  /// Инкремент при смене пароля / деактивации — инвалидирует JWT ЛК.
  sessionVersion           Int                      @default(0)
  achievements             Achievement[]
  attendances              Attendance[]
  clientMemberships        ClientMembership[]
  clientStandards          ClientStandard[]
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitionParticipants  CompetitionParticipant[]
  groupMemberships         GroupMembership[]
  parents                  Parent[]
  payments                 Payment[]
  promoCodeUsages          PromoCodeUsage[]
  referralClicks           ReferralClick[]
  transactions             Transaction[]
  financeOperations        FinanceOperation[]
  supportTickets           SupportTicket[] @relation("ClientSupportTickets")
  chatThreads              ChatThread[]
  contracts                ClientContract[]

  @@index([tenantId, isActive])
  @@index([tenantId, firstName, lastName])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("clients")
}

/// Договор спортсмена (PDF на диске).
model ClientContract {
  id             String                   @id @default(cuid())
  tenantId       String
  clientId       String
  title          String
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  signedAt       DateTime?
  uploadedById   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy     User?                    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  addenda        ClientContractAddendum[]

  @@index([clientId, createdAt])
  @@index([tenantId])
  @@map("client_contracts")
}

model ClientContractAddendum {
  id             String         @id @default(cuid())
  contractId     String
  title          String
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  signedAt       DateTime?
  uploadedById   String?
  createdAt      DateTime       @default(now())
  contract       ClientContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy     User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@map("client_contract_addenda")
}

model Parent {
  id               String   @id @default(cuid())
  fullName         String
  phone            String?
  email            String?
  workplace        String?
  workplaceContact String?
  /// mother | father | guardian | other
  relationType     String?
  isPrimaryContact Boolean  @default(false)
  clientId         String
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Поля для подтверждения регистрации (автоматически подтверждается при создании)
  isApproved       Boolean  @default(true) // Подтвержден ли родитель (автоматически true)
  approvedAt       DateTime? // Дата подтверждения
  // Поля для личного кабинета родителя
  password                 String? // Пароль для авторизации
  emailVerified            Boolean                  @default(false)
  isAccountApproved        Boolean                  @default(false) // Подтвержден ли аккаунт администратором
  accountApprovedAt        DateTime? // Дата подтверждения
  accountApprovedBy        String? // Кто подтвердил (userId)
  lastLogin                DateTime? // Последний вход
  /// Инкремент при смене пароля — инвалидирует JWT ЛК родителя.
  sessionVersion           Int       @default(0)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportTickets   SupportTicket[] @relation("ParentSupportTickets")

  @@map("parents")
}

/// Одноразовые коды для подтверждения email и сброса пароля.
model EmailOtp {
  id          String   @id @default(cuid())
  email       String
  /// verify | reset
  purpose     String
  codeHash    String
  /// user | client | parent — для verify; для reset может быть null до выбора аккаунта
  accountType String?
  accountId   String?
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([email, purpose])
  @@index([accountType, accountId, purpose])
  @@map("email_otps")
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        String
  clientId    String
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model Standard {
  id              String           @id @default(cuid())
  name            String
  description     String?
  unit            String?
  targetValue     Decimal?
  category        String?
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clientStandards ClientStandard[]
  groups          StandardGroup[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("standards")
}

model ClientStandard {
  id          String   @id @default(cuid())
  clientId    String
  standardId  String
  completedAt DateTime
  result      Decimal?
  resultText  String?
  status      String   @default("completed")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@map("client_standards")
}

model StandardGroup {
  id         String   @id @default(cuid())
  standardId String
  groupId    String
  createdAt  DateTime @default(now())
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([standardId, groupId])
  @@map("standard_groups")
}

model Trainer {
  id                   String                       @id @default(cuid())
  userId               String                       @unique
  qualification        String?
  experience           Int?
  specialization       String?
  /// Legacy: синхронизируется с salaryScheme при записи
  salaryType           String
  salaryAmount         Decimal?
  /// per_training_person | fixed_per_student_month | percent_month | fixed_monthly
  salaryScheme         String                       @default("per_training_person")
  /// ₽ для схем 1/2/4; процент для percent_month
  salaryRate           Decimal?
  isActive             Boolean                      @default(true)
  tenantId             String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  canViewAllGroups     Boolean                      @default(false)
  balance              Decimal                      @default(0)
  salaryPercentage     Decimal?
  competitionTrainers  CompetitionTrainer[]
  groups               Group[]
  branches             TrainerBranch[]
  salaryLedgers        TrainerSalaryLedger[]
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainings            Training[]                   @relation("TrainingTrainer")
  substituteTrainings  Training[]                   @relation("TrainingSubstitute")
  transactions         Transaction[]
  financeOperations    FinanceOperation[]
  notificationSettings TrainerNotificationSettings?
  chatThreads          ChatThread[]

  @@index([tenantId, isActive])
  @@index([tenantId, userId])
  @@map("trainers")
}

/// Построчный реестр начислений/выплат зарплаты сотрудника
model TrainerSalaryLedger {
  id           String   @id @default(cuid())
  tenantId     String
  trainerId    String
  /// training_visit | membership_share | membership_percent | fixed_monthly | bonus | adjustment | payout
  kind         String
  amount       Decimal
  occurredAt   DateTime
  personName   String?
  title        String
  comment      String   @default("")
  clientId     String?
  trainingId   String?
  groupId      String?
  paymentId    String?
  attendanceId String?
  /// Для fixed_monthly: "YYYY-MM"; для payout/bonus может быть null
  periodKey    String?
  createdAt    DateTime @default(now())
  trainer      Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([trainerId, attendanceId])
  @@unique([trainerId, paymentId, kind])
  @@unique([trainerId, kind, periodKey])
  @@index([tenantId, trainerId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("trainer_salary_ledgers")
}

model TrainerNotificationSettings {
  id                    String   @id @default(cuid())
  trainerId             String   @unique
  // Время уведомления о всех тренировках (в минутах от начала дня, например 480 = 8:00)
  allTrainingsTime      Int? // Время в минутах от полуночи (0-1439)
  allTrainingsEnabled   Boolean  @default(false)
  // Период уведомлений о тренировках ('tomorrow', 'week', 'month')
  notificationPeriod    String?  @default("tomorrow") // За какой период уведомлять: 'tomorrow' - завтра, 'week' - на неделю, 'month' - на месяц
  // Напоминание перед тренировкой (в минутах до начала)
  reminderBeforeMinutes Int? // За сколько минут до тренировки напоминать (например, 30, 60, 120)
  reminderEnabled       Boolean  @default(false)
  // Часовой пояс тренера (например, 'Europe/Moscow', 'UTC', 'America/New_York')
  timezone              String?  @default("UTC") // IANA timezone identifier
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  trainer               Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("trainer_notification_settings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String // ID пользователя (тренера / OWNER / ADMIN)
  endpoint  String // URL endpoint для отправки уведомлений
  p256dh    String // Публичный ключ
  auth      String // Auth secret
  userAgent String? // User agent браузера
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

/// Предпочтения уведомлений (чаты, changelog, расписание доставки).
model NotificationPreference {
  id                   String   @id @default(cuid())
  /// USER | CLIENT | PARENT | SUPER_ADMIN | TESTER
  actorType            String
  actorId              String
  chatMessagesEnabled  Boolean  @default(true)
  changelogEnabled     Boolean  @default(true)
  pushMasterEnabled    Boolean  @default(true)
  /// ALWAYS | WINDOW — только для школьного staff (USER)
  scheduleMode         String   @default("ALWAYS")
  /// Начало разрешённого окна (минуты от полуночи), при WINDOW
  windowStartMinutes   Int?
  /// Конец разрешённого окна (минуты от полуночи), при WINDOW
  windowEndMinutes     Int?
  /// CSV дней недели 1-7 (пн=1); null = каждый день
  daysOfWeek           String?
  timezone             String   @default("Europe/Moscow")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([actorType, actorId])
  @@index([actorType, actorId])
  @@map("notification_preferences")
}

/// Web Push для ЛК клиента / родителя
model PortalPushSubscription {
  id        String   @id @default(cuid())
  clientId  String?
  parentId  String?
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, endpoint])
  @@unique([parentId, endpoint])
  @@index([clientId])
  @@index([parentId])
  @@map("portal_push_subscriptions")
}

model Group {
  id                        String            @id @default(cuid())
  name                      String
  description               String?
  maxMembers                Int?
  ageMin                    Int?
  ageMax                    Int?
  isActive                  Boolean           @default(true)
  tenantId                  String
  branchId                  String
  trainerId                 String
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  color                     String?
  trainingPrice             Decimal?
  schedule                  String?
  // Ежемесячная оплата
  isMonthlyPayment          Boolean           @default(false)
  monthlyPaymentAmount      Decimal?
  paymentDueDay             Int? // День месяца для оплаты (1-31)
  // Настройки зарплаты тренера (legacy)
  trainerSalaryType         String? // 'monthly_percentage', 'per_visit_percentage', 'per_visit_amount'
  trainerMonthlyPercentage  Decimal? // Процент от ежемесячной суммы оплаченной клиентами
  trainerPerVisitPercentage Decimal? // Процент за посещение
  trainerPerVisitAmount     Decimal? // Фиксированная сумма за посещение
  /// Схема зарплаты на группе: per_training_person | fixed_per_student_month | percent_month
  salaryScheme              String?
  /// Ставка (₽) или процент в зависимости от salaryScheme
  salaryRate                Decimal?
  memberships               GroupMembership[]
  standardGroups            StandardGroup[]
  branch                    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer                   Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainings                 Training[]
  payments                  Payment[]
  financeOperations         FinanceOperation[]
  schoolEvents              SchoolEvent[]
  chatThreads               ChatThread[]

  @@index([tenantId, isActive])
  @@index([tenantId, branchId])
  @@index([tenantId, trainerId])
  @@map("groups")
}

model GroupMembership {
  id              String    @id @default(cuid())
  clientId        String
  groupId         String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  isActive        Boolean   @default(true)
  /// Временное членство на пробное занятие (не делает клиента «не лидом»)
  isTrial         Boolean   @default(false)
  trialTrainingId String?
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trialTraining   Training? @relation(fields: [trialTrainingId], references: [id], onDelete: SetNull)

  @@unique([clientId, groupId])
  @@index([clientId, isActive])
  @@index([groupId, isActive])
  @@index([isTrial, isActive])
  @@map("group_memberships")
}

model Membership {
  id                String             @id @default(cuid())
  name              String
  description       String?
  price             Decimal
  duration          Int?
  type              String
  isActive          Boolean            @default(true)
  tenantId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  visits            Int?
  clientMemberships ClientMembership[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@map("memberships")
}

model ClientMembership {
  id           String     @id @default(cuid())
  clientId     String
  membershipId String
  startDate    DateTime   @default(now())
  endDate      DateTime?
  visitsUsed   Int        @default(0)
  visitsTotal  Int?
  isActive     Boolean    @default(true)
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("client_memberships")
}

model Payment {
  id               String          @id @default(cuid())
  amount           Decimal
  type             String
  status           String
  paymentMethod    String?
  notes            String?
  dueDate          DateTime?
  paidAt           DateTime?
  clientId         String
  membershipId     String?
  branchId         String?
  groupId          String? // Связь с группой для ежемесячных платежей
  tenantId         String
  isMonthlyPayment Boolean         @default(false) // Является ли это ежемесячным платежом
  originalAmount   Decimal? // Оригинальная сумма до перерасчета
  /// Период ежемесячного платежа (YYYY-MM); уникален вместе с client+group (partial unique в SQL)
  periodKey        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  branch           Branch?         @relation(fields: [branchId], references: [id])
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership       Membership?     @relation(fields: [membershipId], references: [id])
  group            Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCodeUsage   PromoCodeUsage?
  transactions     Transaction[]
  financeOperations FinanceOperation[]

  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, paidAt])
  @@index([tenantId, clientId, groupId, periodKey])
  @@map("payments")
}

model Training {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  startTime           DateTime
  endTime             DateTime
  isRecurring         Boolean       @default(false)
  recurrence          String?
  isCancelled         Boolean       @default(false)
  tenantId            String
  branchId            String
  groupId             String?
  trainerId           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  hallId              String?
  // Цена и тип заработка тренера для индивидуальных тренировок
  price               Decimal?
  trainerEarningType  String? // 'percentage', 'amount'
  trainerEarningValue Decimal? // Процент или сумма
  // Замена тренера
  substituteTrainerId String? // ID тренера-замены
  originalTrainerId   String? // ID оригинального тренера (если есть замена)
  attendances         Attendance[]
  trialMemberships    GroupMembership[]
  branch              Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group               Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hall                Hall?         @relation(fields: [hallId], references: [id])
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer             Trainer       @relation("TrainingTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  substituteTrainer   Trainer?      @relation("TrainingSubstitute", fields: [substituteTrainerId], references: [id])
  transactions        Transaction[]

  @@index([tenantId, startTime])
  @@index([tenantId, trainerId, startTime])
  @@index([tenantId, groupId, startTime])
  @@index([trainerId, startTime])
  @@index([tenantId, isCancelled])
  @@map("trainings")
}

model Attendance {
  id           String        @id @default(cuid())
  status       String
  notes        String?
  clientId     String
  trainingId   String
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shouldCharge Boolean       @default(true)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  training     Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([clientId, trainingId])
  @@index([tenantId, createdAt])
  @@index([tenantId, trainingId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("attendances")
}

model Transaction {
  id           String      @id @default(cuid())
  type         String
  amount       Decimal
  description  String?
  clientId     String?
  trainerId    String?
  trainingId   String?
  attendanceId String?
  paymentId    String?
  tenantId     String
  createdAt    DateTime    @default(now())
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  client       Client?     @relation(fields: [clientId], references: [id])
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer      Trainer?    @relation(fields: [trainerId], references: [id])
  training     Training?   @relation(fields: [trainingId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, clientId])
  @@index([tenantId, trainerId])
  @@map("transactions")
}

/// Тип финансовой операции (системный или кастомный для тенанта).
model FinanceOperationType {
  id                String   @id @default(cuid())
  /// null — системный тип, доступен всем школам
  tenantId          String?
  code              String
  name              String
  /// 'income' | 'expense'
  defaultDirection  String
  isSystem          Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("finance_operation_types")
}

/// Единая история поступлений и расходов школы (раздел «Финансы»).
model FinanceOperation {
  id          String    @id @default(cuid())
  tenantId    String
  /// 'income' | 'expense'
  direction   String
  typeCode    String
  title       String
  amount      Decimal
  occurredAt  DateTime  @default(now())
  notes       String?
  clientId    String?
  trainerId   String?
  groupId     String?
  branchId    String?
  /// Идемпотентная связь с Payment при авто-создании из оплаты
  paymentId   String?   @unique
  /// Идемпотентный ключ для прочих событий (выдача абонемента, начисление и т.д.)
  externalKey String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  trainer     Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, typeCode])
  @@index([tenantId, direction])
  @@index([tenantId, clientId])
  @@index([tenantId, trainerId])
  @@index([tenantId, groupId])
  @@index([tenantId, branchId])
  @@map("finance_operations")
}

model TrainerBranch {
  id        String   @id @default(cuid())
  trainerId String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, branchId])
  @@map("trainer_branches")
}

model Marketer {
  id                   String             @id @default(cuid())
  name                 String
  email                String
  password             String
  phone                String?
  type                 String
  isActive             Boolean            @default(true)
  tenantId             String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  balance              Decimal            @default(0)
  commissionPercentage Decimal            @default(10)
  adminTransactions    AdminTransaction[]
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCodes           PromoCode[]
