generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                   @id @default(cuid())
  name                    String
  subdomain               String                   @unique
  email                   String                   @unique
  phone                   String?
  address                 String?
  logo                    String?
  settings                String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  attendances             Attendance[]
  branches                Branch[]
  clientMemberships       ClientMembership[]
  clients                 Client[]
  competitionAttendances  CompetitionAttendance[]
  competitionParticipants CompetitionParticipant[]
  competitionTrainers     CompetitionTrainer[]
  competitions            Competition[]
  groups                  Group[]
  halls                   Hall[]
  marketers               Marketer[]
  memberships             Membership[]
  parents                 Parent[]
  payments                Payment[]
  promoCodeAdmins         PromoCodeAdmin[]
  promoCodeUsages         PromoCodeUsage[]
  promoCodes              PromoCode[]
  referralClicks          ReferralClick[]
  referralLinks           ReferralLink[]
  standards               Standard[]
  subscription            Subscription?
  referredBy              TenantMarketer?
  tenantSettings          TenantSettings?
  trainers                Trainer[]
  trainings               Training[]
  transactions            Transaction[]
  users                   User[]

  @@map("tenants")
}

model TenantSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  defaultTrainingDuration Int      @default(60)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  hasCompletedOnboarding  Boolean  @default(false)
  onboardingDeclined      Boolean  @default(false)
  membershipFeeResetDate  String?
  // Настройки личного кабинета клиента
  clientCanViewAllTrainers Boolean  @default(false) // Может ли клиент видеть всех тренеров или только своего
  clientCanViewAllBranches Boolean  @default(false) // Может ли клиент видеть все филиалы или только свой
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  firstName  String
  lastName   String
  phone      String?
  role       String
  isActive   Boolean   @default(true)
  lastLogin  DateTime?
  tenantId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  middleName String?
  trainer    Trainer?
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Branch {
  id          String          @id @default(cuid())
  name        String
  address     String
  phone       String?
  email       String?
  description String?
  isActive    Boolean         @default(true)
  tenantId    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups      Group[]
  halls       Hall[]
  payments    Payment[]
  trainers    TrainerBranch[]
  trainings   Training[]

  @@map("branches")
}

model Hall {
  id          String     @id @default(cuid())
  name        String
  description String?
  capacity    Int?
  isActive    Boolean    @default(true)
  branchId    String
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainings   Training[]

  @@map("halls")
}

model Client {
  id                       String                   @id @default(cuid())
  firstName                String
  lastName                 String
  middleName               String?
  email                    String?
  phone                    String?
  dateOfBirth              DateTime?
  gender                   String?
  address                  String?
  emergencyContact         String?
  emergencyPhone           String?
  medicalNotes             String?
  photo                    String?
  isActive                 Boolean                  @default(true)
  tenantId                 String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  birthCertificateNumber   String?
  medicalCertificateNumber String?
  schoolOrKindergarten     String?
  balance                  Decimal                  @default(0)
  birthCertificate         String?
  medicalCertificate       String?
  weight                   Decimal?
  membershipFeePaid        Boolean                  @default(false)
  membershipFeePaidAt      DateTime?
  membershipFeePaidBy      String?
  passportBirthPlace       String?
  passportDivisionCode     String?
  passportIssueDate        DateTime?
  passportIssuedBy         String?
  passportNumber           String?
  passportSeries           String?
  // Поля для личного кабинета клиента
  password                 String?                  // Пароль для авторизации
  isAccountApproved        Boolean                  @default(false) // Подтвержден ли аккаунт администратором
  accountApprovedAt        DateTime?                // Дата подтверждения
  accountApprovedBy        String?                  // Кто подтвердил (userId)
  lastLogin                DateTime?                // Последний вход
  achievements             Achievement[]
  attendances              Attendance[]
  clientMemberships        ClientMembership[]
  clientStandards          ClientStandard[]
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitionParticipants  CompetitionParticipant[]
  groupMemberships         GroupMembership[]
  parents                  Parent[]
  payments                 Payment[]
  promoCodeUsages          PromoCodeUsage[]
  referralClicks           ReferralClick[]
  transactions             Transaction[]

  @@map("clients")
}

model Parent {
  id               String   @id @default(cuid())
  fullName         String
  phone            String?
  email            String?
  workplace        String?
  workplaceContact String?
  clientId         String
  tenantId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("parents")
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        String
  clientId    String
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model Standard {
  id              String           @id @default(cuid())
  name            String
  description     String?
  unit            String?
  targetValue     Decimal?
  category        String?
  isActive        Boolean          @default(true)
  tenantId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clientStandards ClientStandard[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("standards")
}

model ClientStandard {
  id          String   @id @default(cuid())
  clientId    String
  standardId  String
  completedAt DateTime
  result      Decimal?
  resultText  String?
  status      String   @default("completed")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@map("client_standards")
}

model Trainer {
  id                  String               @id @default(cuid())
  userId              String               @unique
  qualification       String?
  experience          Int?
  specialization      String?
  salaryType          String
  salaryAmount        Decimal?
  isActive            Boolean              @default(true)
  tenantId            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  canViewAllGroups    Boolean              @default(false)
  balance             Decimal              @default(0)
  salaryPercentage    Decimal?
  competitionTrainers CompetitionTrainer[]
  groups              Group[]
  branches            TrainerBranch[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainings           Training[]
  transactions        Transaction[]

  @@map("trainers")
}

model Group {
  id            String            @id @default(cuid())
  name          String
  description   String?
  maxMembers    Int?
  ageMin        Int?
  ageMax        Int?
  isActive      Boolean           @default(true)
  tenantId      String
  branchId      String
  trainerId     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  color         String?
  trainingPrice Decimal?
  schedule      String?
  memberships   GroupMembership[]
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer       Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  trainings     Training[]

  @@map("groups")
}

model GroupMembership {
  id       String    @id @default(cuid())
  clientId String
  groupId  String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isActive Boolean   @default(true)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([clientId, groupId])
  @@map("group_memberships")
}

model Membership {
  id                String             @id @default(cuid())
  name              String
  description       String?
  price             Decimal
  duration          Int?
  type              String
  isActive          Boolean            @default(true)
  tenantId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  visits            Int?
  clientMemberships ClientMembership[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@map("memberships")
}

model ClientMembership {
  id           String     @id @default(cuid())
  clientId     String
  membershipId String
  startDate    DateTime   @default(now())
  endDate      DateTime?
  visitsUsed   Int        @default(0)
  visitsTotal  Int?
  isActive     Boolean    @default(true)
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("client_memberships")
}

model Payment {
  id             String          @id @default(cuid())
  amount         Decimal
  type           String
  status         String
  paymentMethod  String?
  notes          String?
  dueDate        DateTime?
  paidAt         DateTime?
  clientId       String
  membershipId   String?
  branchId       String?
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branch         Branch?         @relation(fields: [branchId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  membership     Membership?     @relation(fields: [membershipId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCodeUsage PromoCodeUsage?
  transactions   Transaction[]

  @@map("payments")
}

model Training {
  id           String        @id @default(cuid())
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  isRecurring  Boolean       @default(false)
  recurrence   String?
  isCancelled  Boolean       @default(false)
  tenantId     String
  branchId     String
  groupId      String?
  trainerId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hallId       String?
  attendances  Attendance[]
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  hall         Hall?         @relation(fields: [hallId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer      Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("trainings")
}

model Attendance {
  id           String        @id @default(cuid())
  status       String
  notes        String?
  clientId     String
  trainingId   String
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  shouldCharge Boolean       @default(true)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  training     Training      @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([clientId, trainingId])
  @@map("attendances")
}

model Transaction {
  id           String      @id @default(cuid())
  type         String
  amount       Decimal
  description  String?
  clientId     String?
  trainerId    String?
  trainingId   String?
  attendanceId String?
  paymentId    String?
  tenantId     String
  createdAt    DateTime    @default(now())
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  client       Client?     @relation(fields: [clientId], references: [id])
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer      Trainer?    @relation(fields: [trainerId], references: [id])
  training     Training?   @relation(fields: [trainingId], references: [id])

  @@map("transactions")
}

model TrainerBranch {
  id        String   @id @default(cuid())
  trainerId String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  trainer   Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, branchId])
  @@map("trainer_branches")
}

model Marketer {
  id                   String             @id @default(cuid())
  name                 String
  email                String
  password             String
  phone                String?
  type                 String
  isActive             Boolean            @default(true)
  tenantId             String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  balance              Decimal            @default(0)
  commissionPercentage Decimal            @default(10)
  adminTransactions    AdminTransaction[]
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoCodes           PromoCode[]
  referralLinks        ReferralLink[]
  referredTenants      TenantMarketer[]

  @@map("marketers")
}

model PromoCodeAdmin {
  id        String   @id @default(cuid())
  name      String
  email     String
  password  String
  phone     String?
  isActive  Boolean  @default(true)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("promo_code_admins")
}

model PromoCode {
  id            String           @id @default(cuid())
  code          String
  description   String?
  discountType  String
  discountValue Decimal
  minPurchase   Decimal?
  maxDiscount   Decimal?
  usageLimit    Int?
  usedCount     Int              @default(0)
  isActive      Boolean          @default(true)
  validFrom     DateTime
  validUntil    DateTime?
  tenantId      String
  marketerId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  usages        PromoCodeUsage[]
  marketer      Marketer?        @relation(fields: [marketerId], references: [id])
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([code, tenantId])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id                    String               @id @default(cuid())
  promoCodeId           String
  clientId              String?
  paymentId             String?              @unique
  usedAt                DateTime             @default(now())
  discountAmount        Decimal
  tenantId              String
  subscriptionPaymentId String?              @unique
  client                Client?              @relation(fields: [clientId], references: [id])
  payment               Payment?             @relation(fields: [paymentId], references: [id])
  promoCode             PromoCode            @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  subscriptionPayment   SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("promo_code_usages")
}

model ReferralLink {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  url         String
  isActive    Boolean         @default(true)
  tenantId    String
  marketerId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  clicks      ReferralClick[]
  marketer    Marketer?       @relation(fields: [marketerId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("referral_links")
}

model ReferralClick {
  id             String       @id @default(cuid())
  referralLinkId String
  clientId       String?
  ipAddress      String?
  userAgent      String?
  clickedAt      DateTime     @default(now())
  converted      Boolean      @default(false)
  conversionDate DateTime?
  tenantId       String
  client         Client?      @relation(fields: [clientId], references: [id])
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("referral_clicks")
}

model Subscription {
  id           String                @id @default(cuid())
  tenantId     String                @unique
  planType     String
  status       String
  startDate    DateTime              @default(now())
  endDate      DateTime?
  autoRenew    Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  nextPlanType String?
  payments     SubscriptionPayment[]
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SubscriptionPayment {
  id                 String          @id @default(cuid())
  subscriptionId     String
  amount             Decimal
  currency           String          @default("RUB")
  status             String
  paymentMethod      String?
  yookassaPaymentId  String?
  yookassaPaymentUrl String?
  paidAt             DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  promoCodeUsage     PromoCodeUsage?
  subscription       Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

model TenantMarketer {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  marketerId           String
  commissionPercentage Decimal  @default(10)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  marketer             Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_marketers")
}

model SuperAdminSettings {
  id                String   @id @default(cuid())
  reservePercentage Decimal?
  reserveAmount     Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("super_admin_settings")
}

model SuperAdmin {
  id           String             @id @default(cuid())
  email        String             @unique
  password     String
  firstName    String
  lastName     String
  isActive     Boolean            @default(true)
  lastLogin    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions AdminTransaction[]

  @@map("super_admins")
}

model AdminTransaction {
  id           String      @id @default(cuid())
  type         String
  amount       Decimal
  description  String
  marketerId   String?
  superAdminId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  marketer     Marketer?   @relation(fields: [marketerId], references: [id])
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id])

  @@map("admin_transactions")
}

model Competition {
  id                       String                   @id @default(cuid())
  name                     String
  location                 String
  startDate                DateTime
  endDate                  DateTime
  registrationDate         DateTime
  registrationTime         DateTime?
  isElectronicRegistration Boolean                  @default(false)
  positionDocument         String?
  regulationsDocument      String?
  tenantId                 String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  attendances              CompetitionAttendance[]
  participants             CompetitionParticipant[]
  results                  CompetitionResult[]
  trainers                 CompetitionTrainer[]
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("competitions")
}

model CompetitionParticipant {
  id            String                 @id @default(cuid())
  competitionId String
  clientId      String
  tenantId      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  attendance    CompetitionAttendance?
  client        Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results       CompetitionResult[]

  @@unique([competitionId, clientId])
  @@map("competition_participants")
}

model CompetitionResult {
  id              String                 @id @default(cuid())
  competitionId   String
  participantId   String
  result          String?
  resultValue     Decimal?
  category        String?
  performanceTime DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  competition     Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant     CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("competition_results")
}

model CompetitionTrainer {
  id            String      @id @default(cuid())
  competitionId String
  trainerId     String
  tenantId      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainer       Trainer     @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([competitionId, trainerId])
  @@map("competition_trainers")
}

model CompetitionAttendance {
  id            String                 @id @default(cuid())
  competitionId String
  participantId String                 @unique
  status        String
  notes         String?
  tenantId      String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  competition   Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant   CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("competition_attendances")
}
