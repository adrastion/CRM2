model PromoCodeUsage {
  id                    String               @id @default(cuid())
  promoCodeId           String
  clientId              String?
  paymentId             String?              @unique
  usedAt                DateTime             @default(now())
  discountAmount        Decimal
  tenantId              String
  subscriptionPaymentId String?              @unique
  client                Client?              @relation(fields: [clientId], references: [id])
  payment               Payment?             @relation(fields: [paymentId], references: [id])
  promoCode             PromoCode            @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  subscriptionPayment   SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id])
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("promo_code_usages")
}

model ReferralLink {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  url         String
  isActive    Boolean         @default(true)
  tenantId    String
  marketerId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  clicks      ReferralClick[]
  marketer    Marketer?       @relation(fields: [marketerId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("referral_links")
}

model ReferralClick {
  id             String       @id @default(cuid())
  referralLinkId String
  clientId       String?
  ipAddress      String?
  userAgent      String?
  clickedAt      DateTime     @default(now())
  converted      Boolean      @default(false)
  conversionDate DateTime?
  tenantId       String
  client         Client?      @relation(fields: [clientId], references: [id])
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("referral_clicks")
}

model Subscription {
  id           String                @id @default(cuid())
  tenantId     String                @unique
  planType     String
  status       String
  startDate    DateTime              @default(now())
  endDate      DateTime?
  autoRenew    Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  nextPlanType String?
  // Тариф выдан супер-админом вручную, а не оплачен клиентом.
  // Такие подписки исключаются из финансовых метрик (MRR/ARR/прогноз/конверсия).
  isGranted    Boolean               @default(false)
  grantedAt    DateTime?
  grantedBy    String? // id супер-админа, выдавшего тариф
  payments     SubscriptionPayment[]
  grantLogs    SubscriptionGrantLog[]
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Каталог тарифов. `code` неизменяем и используется во всех связях,
/// поэтому переименование тарифа не затрагивает историю подписок и платежей.
model SubscriptionPlan {
  id            String   @id @default(cuid())
  code          String   @unique // FREE, STARTER, ... — не меняется после создания
  name          String // Отображаемое название, редактируется супер-админом
  description   String?
  /// null означает «Цена договорная» (тариф ENTERPRISE и подобные)
  price         Decimal?
  /// null в лимитах означает «Безлимит»
  maxTrainers   Int?
  maxClients    Int?
  maxGroups     Int?
  maxBranches   Int?
  maxTrainings  Int?
  /// false — индивидуальный тариф: не отображается на странице /pricing,
  /// выдаётся только вручную из панели супер-админа
  isPublic      Boolean  @default(true)
  /// Soft-delete: архивный тариф нельзя выдать, но история по нему сохраняется
  isActive      Boolean  @default(true)
  /// Порядок тарифа в иерархии. Сравнение «выше/ниже» идёт по нему, а не по цене,
  /// т.к. у ENTERPRISE цена договорная и не сопоставима численно.
  sortOrder     Int      @default(0)
  supportLevel  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, isPublic])
  @@map("subscription_plans")
}

/// История выдачи и продления тарифов супер-админом: кто, когда и что изменил.
model SubscriptionGrantLog {
  id             String       @id @default(cuid())
  subscriptionId String
  tenantId       String
  superAdminId   String?
  /// 'grant' — выдача тарифа, 'extend' — изменение срока, 'revoke' — снятие
  action         String
  planCode       String
  oldPlanCode    String?
  oldEndDate     DateTime?
  newEndDate     DateTime?
  comment        String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  superAdmin     SuperAdmin?  @relation(fields: [superAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("subscription_grant_logs")
}

model SubscriptionPayment {
  id                 String          @id @default(cuid())
  subscriptionId     String
  amount             Decimal
  currency           String          @default("RUB")
  status             String
  paymentMethod      String?
  yookassaPaymentId  String?
  yookassaPaymentUrl String?
  paidAt             DateTime?
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  /// Снимок тарифа на момент оплаты. Нужен, чтобы последующее изменение цены
  /// в каталоге не переписывало историю выручки.
  planCode           String?
  listPrice          Decimal? // цена тарифа до скидки на момент оплаты
  discountAmount     Decimal? // размер скидки по промокоду
  promoCodeUsage     PromoCodeUsage?
  subscription       Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

model TenantMarketer {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  marketerId           String
  commissionPercentage Decimal  @default(10)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  marketer             Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_marketers")
}

model SuperAdminSettings {
  id                  String        @id @default(cuid())
  reservePercentage   Decimal?
  reserveAmount       Decimal?
  /// Абсолютный путь к файлу ошибок сервера.
  /// По умолчанию — logs/err.log в корне проекта (см. logFileService).
  errorLogPath        String?
  /// Алерты критической нагрузки сервера
  alertsEnabled       Boolean       @default(true)
  alertCpuPercent     Float         @default(90)
  alertMemoryPercent  Float         @default(90)
  alertDiskPercent    Float         @default(90)
  /// Порог load1 = alertLoadPerCore * число ядер CPU
  alertLoadPerCore    Float         @default(1)
  alertCooldownMinutes Int          @default(15)
  lastAlertAt         DateTime?
  budgetLimits        BudgetLimit[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("super_admin_settings")
}

/// Сэмплы метрик нагрузки сервера (сбор каждые ~30 с)
model ServerMetricSample {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  cpuPercent     Float
  memoryPercent  Float
  memoryUsedMb   Float
  memoryTotalMb  Float
  load1          Float
  load5          Float
  load15         Float
  diskPercent    Float
  diskUsedGb     Float
  diskTotalGb    Float
  cpuCores       Int

  @@index([timestamp])
  @@map("server_metric_samples")
}

/// Web Push подписки супер-админов (критические алерты нагрузки)
model SuperAdminPushSubscription {
  id           String     @id @default(cuid())
  superAdminId String
  endpoint     String
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@unique([superAdminId, endpoint])
  @@map("super_admin_push_subscriptions")
}

model BudgetLimit {
