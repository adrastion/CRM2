  @@map("expense_categories")
}

model AdminTransaction {
  id              String           @id @default(cuid())
  type            String
  amount          Decimal
  description     String
  marketerId      String?
  superAdminId    String?
  categoryId      String? // Категория расхода
  documentUrl     String? // URL прикрепленного документа
  isRecurring     Boolean          @default(false) // Повторяющийся расход
  recurringPeriod String? // 'monthly', 'quarterly', 'yearly'
  nextDueDate     DateTime? // Следующая дата для повторяющегося расхода
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  marketer        Marketer?        @relation(fields: [marketerId], references: [id])
  superAdmin      SuperAdmin?      @relation(fields: [superAdminId], references: [id])
